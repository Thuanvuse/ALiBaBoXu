  <diagram name="PlantUML" id="plantuml-1"><![CDATA[
@startuml
left to right direction
actor "Khách hàng" as Customer
actor "Nhân viên tiếp nhận" as Receptionist
actor "Kỹ thuật viên" as Technician
actor "Quản trị viên" as Admin

rectangle "Hệ thống quản lý dịch vụ chăm sóc máy tính" {
  (Đăng ký / Đăng nhập)
  (Xem danh mục dịch vụ)
  (Yêu cầu dịch vụ)
  (Lên lịch dịch vụ)
  (Tạo phiếu dịch vụ)
  (Chẩn đoán)
  (Sửa chữa)
  (Cập nhật trạng thái dịch vụ)
  (Tạo hóa đơn)
  (Thanh toán)
  (Quản lý dịch vụ)
  (Quản lý người dùng)
  (Quản lý tồn kho)
  (Báo cáo)
}

Customer -- (Đăng ký / Đăng nhập)
Customer -- (Xem danh mục dịch vụ)
Customer -- (Yêu cầu dịch vụ)
Customer -- (Lên lịch dịch vụ)
Customer -- (Thanh toán)

Receptionist -- (Đăng ký / Đăng nhập)
Receptionist -- (Tạo phiếu dịch vụ)
Receptionist -- (Lên lịch dịch vụ)
Receptionist -- (Tạo hóa đơn)

Technician -- (Chẩn đoán)
Technician -- (Sửa chữa)
Technician -- (Cập nhật trạng thái dịch vụ)
Technician -- (Xem danh mục dịch vụ)

Admin -- (Quản lý dịch vụ)
Admin -- (Quản lý người dùng)
Admin -- (Quản lý tồn kho)
Admin -- (Báo cáo)

(Chẩn đoán) .> (Tạo phiếu dịch vụ) : <<include>>
(Sửa chữa) .> (Cập nhật trạng thái dịch vụ) : <<include>>
(Tạo hóa đơn) .> (Thanh toán) : <<include>>

@enduml
]]></diagram>
</mxfile>
